[Unit]
Description=hwpanel hardware daemon (limits GPU/CPU clocks, no overclocking)
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/hwpanel/hwpaneld.py
# On every stop (also crash or watchdog) the fan goes back to driver automatic mode
ExecStopPost=-/bin/sh -c 'echo 2 | tee /sys/class/drm/card*/device/hwmon/hwmon*/pwm1_enable >/dev/null 2>&1'
Restart=on-failure
RestartSec=3
# A hung daemon must not leave the fan at a fixed value
NotifyAccess=main
WatchdogSec=20
RuntimeDirectory=hwpanel
RuntimeDirectoryMode=0755
StateDirectory=hwpanel

# Hardening: the daemon reads sysfs/proc, writes sysfs and /var/lib/hwpanel, and offers a Unix socket.
# Only options from systemd 245 on, so that the unit also runs on older distributions.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
# Do NOT set ProtectKernelTunables=yes: it makes /sys read-only, and the daemon could no longer set anything.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
# Only Unix sockets with a file path (/run/hwpanel/hwpanel.sock): those stay reachable from other network namespaces too.
PrivateNetwork=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# CAP_CHOWN: set the socket group. CAP_DAC_OVERRIDE: sysfs files that a udev rule assigns to a different owner.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE
# @chown is not part of @system-service, but is needed for the socket group.
SystemCallFilter=@system-service @chown
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute deliberately not set: some Python builds (JIT, ctypes) need writable-executable memory.

[Install]
WantedBy=multi-user.target
